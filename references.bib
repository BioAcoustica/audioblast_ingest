@article {50677,
	title = {The acridoidea of Benin (Orthoptera): an  annoted checklist},
	journal = {International Journal of Science and Advanced Technology},
	volume = {2},
	year = {2012},
	pages = {22-52},
	chapter = {22},
	abstract = {<p>S urveys were conducted from 1991 to 1994 and 2001 to 2005, to characterize grasshopper species occurring in Benin. The study covered 50 sites distributed throughout the different agro - ecological zones in Benin. The sampled sites ranged between latitudes 6\&deg;N and 12\&deg; N. An annotated checklist of the 8 6 species encountered in four families and 12 subfamilies was provided. Seven teen species, first recorded in Benin were described. Grasshoppers\&rsquo; ecology and their geographical distribution were described. In addition, habitat, characteristics including vegetations and soils preferred by these grasshopper species were mentionned. Th e different soil types on which the grasshoppers were found were reported. The population abundance of the different species was monitored in relation with the associated host - plants.</p>
},
	keywords = {distribution, diversity, ecological zone, grasshoppers, Orthoptera, West Africa},
	author = {A. A. Para{\"\i}so and O-K. Douro-Kpindu and A. Onzo and A. Thomas Odjo and V. Ahomagnon and F. Obognon and I Godonou}
}
